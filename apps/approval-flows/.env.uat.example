# Toutes les variables server-side sont servies par le vault au démarrage via instrumentation.ts.
# Plus aucun build arg NEXT_PUBLIC_* nécessaire — les configs publiques sont servies à
# l'exécution via /api/public-config.

APP_PORT=3006

# Vault — variables server-side chargées au démarrage du container
VAULT_URL=http://workspace_uat_bk_vault:5007
VAULT_SERVICE=frontend_approval_flows
VAULT_TOKEN=CHANGEME_voir_config_toml_section_tokens
