# Copier en `.env` à côté de docker-compose.yml (jamais committer le .env réel).
# Réseau Docker partagé entre tous les services — à créer une seule fois par
# environnement : `docker network create workspace_uat`
# Les NEXT_PUBLIC_* sont nécessaires au moment du build (passés comme build args
# dans docker-compose.yml) car inlinées dans le bundle navigateur par Next.js.

APP_PORT=3005

NEXT_PUBLIC_AUTH_API=https://api-auth.uat.workspace.cd
NEXT_PUBLIC_AUTH_API_AUTH_DOMAIN=https://auth.uat.workspace.cd
NEXT_PUBLIC_AUTH_API_HR_DOMAIN=https://hr.uat.workspace.cd
NEXT_PUBLIC_AUTH_API_APPROVAL_FLOWS_DOMAIN=https://approval-flows.uat.workspace.cd
NEXT_PUBLIC_WORKSPACE_DOMAIN=https://workspace.uat.workspace.cd

# Server only — résolus via le réseau Docker partagé `workspace_uat`
AUTH_API_URL=http://auth_app:5000
AUDIT_LOGS_API_URL=http://audit_logs_app:5006

NETWORK_ENCRYPTION=encrypted
NETWORK_ENCRYPTION_KEY=changeme
NEXT_PUBLIC_NETWORK_ENCRYPTION=encrypted
NEXT_PUBLIC_NETWORK_ENCRYPTION_KEY=changeme
