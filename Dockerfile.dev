FROM node:24-alpine
WORKDIR /app

# Copy only manifests — layer is cached until a package.json or lockfile changes
COPY package.json package-lock.json turbo.json ./

COPY packages/approval-flows/package.json packages/approval-flows/
COPY packages/auth/package.json            packages/auth/
COPY packages/design-system/package.json   packages/design-system/
COPY packages/eslint-config/package.json   packages/eslint-config/
COPY packages/network/package.json         packages/network/
COPY packages/state/package.json           packages/state/
COPY packages/tailwind-config/package.json packages/tailwind-config/
COPY packages/typescript-config/package.json packages/typescript-config/
COPY packages/ui/package.json              packages/ui/

COPY apps/auth/package.json            apps/auth/
COPY apps/workspace/package.json       apps/workspace/
COPY apps/hr/package.json              apps/hr/
COPY apps/approval-flows/package.json  apps/approval-flows/
COPY apps/web/package.json             apps/web/
COPY apps/docs/package.json            apps/docs/

RUN npm ci
