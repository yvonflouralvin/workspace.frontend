# Copier en `.env` à côté de docker-compose.yml (jamais committer le .env réel).
# Réseau Docker partagé entre tous les services — `dokploy-network` (géré par Dokploy).
# Les NEXT_PUBLIC_* sont nécessaires au moment du build (passés comme build args
# dans docker-compose.yml) car inlinées dans le bundle navigateur par Next.js.

APP_PORT=3003

NEXT_PUBLIC_AUTH_API=https://auth_bk_workspace_uat.saas.cd
NEXT_PUBLIC_AUTH_API_AUTH_DOMAIN=https://auth_ft_workspace_uat.saas.cd
NEXT_PUBLIC_WORKSPACE_DOMAIN=https://workspace_ft_workspace_uat.saas.cd
NEXT_PUBLIC_AUTH_API_APPROVAL_FLOWS_DOMAIN=https://approval-flows_ft_workspace_uat.saas.cd

# Server only — résolus via le réseau Docker partagé `dokploy-network`
AUTH_API_URL=http://workspace_uat_bk_auth:5000
HR_API_URL=http://workspace_uat_bk_hr:5001
GRAPHQL_API_URL=http://workspace_uat_bk_graphql:5002
APPROVAL_FLOWS_API_URL=http://workspace_uat_bk_af:5005

NETWORK_ENCRYPTION=encrypted
NETWORK_ENCRYPTION_KEY=changeme
NEXT_PUBLIC_NETWORK_ENCRYPTION=encrypted
NEXT_PUBLIC_NETWORK_ENCRYPTION_KEY=changeme
