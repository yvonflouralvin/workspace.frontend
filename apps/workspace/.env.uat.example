# Les variables server-side (AUTH_API_URL, AUDIT_LOGS_API_URL, NETWORK_ENCRYPTION_KEY...)
# sont servies par le vault au démarrage via instrumentation.ts.
#
# Les NEXT_PUBLIC_* restent ici car elles doivent être inlinées au moment du BUILD Docker.

APP_PORT=3005

# Build args — inlinées dans le bundle JS navigateur par Next.js
NEXT_PUBLIC_AUTH_API=https://auth-bk-workspace-uat.saas.cd
NEXT_PUBLIC_AUTH_API_AUTH_DOMAIN=https://auth-ft-workspace-uat.saas.cd
NEXT_PUBLIC_AUTH_API_HR_DOMAIN=https://hr-ft-workspace-uat.saas.cd
NEXT_PUBLIC_AUTH_API_APPROVAL_FLOWS_DOMAIN=https://approval-flows-ft-workspace-uat.saas.cd
NEXT_PUBLIC_WORKSPACE_DOMAIN=https://workspace-ft-workspace-uat.saas.cd
NEXT_PUBLIC_NETWORK_ENCRYPTION=encrypted
NEXT_PUBLIC_NETWORK_ENCRYPTION_KEY=CHANGEME_meme_valeur_que_dans_config_toml

# Vault — variables server-side chargées au démarrage du container
VAULT_URL=http://workspace_uat_bk_vault:5007
VAULT_SERVICE=frontend_workspace
VAULT_TOKEN=CHANGEME_voir_config_toml_section_tokens
