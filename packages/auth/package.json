{
  "name": "@repo/auth",
  "type": "module",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc"
  },
  "exports": {
    "./SessionProvider": {
      "types": "./src/providers/SessionProvider.tsx",
      "default": "./dist/providers/SessionProvider.js"
    },
    "./store/session.store": {
      "types": "./src/store/session.store.ts",
